+  // ---- Lightweight inline SVG chart helpers (no external chart library) ----
+
+  function svgBarChart(labels, values, color) {
+    const w = 300, h = 110, padTop = 8, padBottom = 18, padSide = 6;
+    const max = Math.max(...values, 1);
+    const innerW = w - padSide * 2;
+    const gap = innerW / values.length;
+    const barWidth = Math.max(6, gap * 0.55);
+
+    let bars = '';
+    values.forEach((v, i) => {
+      const barHeight = (v / max) * (h - padTop - padBottom);
+      const x = padSide + i * gap + (gap - barWidth) / 2;
+      const y = h - padBottom - barHeight;
+      bars += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barWidth.toFixed(1)}" height="${Math.max(barHeight, 1).toFixed(1)}" rx="3" style="fill:${color};"></rect>`;
+    });
+
+    let tickLabels = '';
+    labels.forEach((l, i) => {
+      const x = padSide + i * gap + gap / 2;
+      tickLabels += `<text x="${x.toFixed(1)}" y="${h - 4}" text-anchor="middle" font-size="9" style="fill:var(--text-subtle);">${l}</text>`;
+    });
+
+    return `<svg viewBox="0 0 ${w} ${h}" style="width:100%; height:${h}px; display:block;">${bars}${tickLabels}</svg>`;
+  }
+
+  function svgLineChart(labels, values, color, opts) {
+    opts = opts || {};
+    const w = 300, h = 100, padTop = 10, padBottom = 18, padSide = 6;
+    const cleanValues = values.map(v => (v === null || v === undefined) ? 0 : v);
+    const max = Math.max(...cleanValues, opts.minMax || 1);
+    const min = opts.zeroFloor === false ? Math.min(...cleanValues) : 0;
+    const range = (max - min) || 1;
+    const innerW = w - padSide * 2;
+    const stepX = values.length > 1 ? innerW / (values.length - 1) : 0;
+
+    const points = cleanValues.map((v, i) => {
+      const x = padSide + i * stepX;
+      const y = h - padBottom - ((v - min) / range) * (h - padTop - padBottom);
+      return [x, y];
+    });
+
+    const polyline = points.map(p => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
+    let area = '';
+    if (opts.area) {
+      const areaPath = `M${points[0][0].toFixed(1)},${(h - padBottom).toFixed(1)} L` +
