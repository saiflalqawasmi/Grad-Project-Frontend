+        ` L${points[points.length - 1][0].toFixed(1)},${(h - padBottom).toFixed(1)} Z`;
+      area = `<path d="${areaPath}" style="fill:${color}; opacity:0.14;"></path>`;
+    }
+    let dots = '';
+    if (opts.dots) {
+      dots = points.map((p, i) => values[i] === null
+        ? ''
+        : `<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="2.5" style="fill:${color};"></circle>`
+      ).join('');
+    }
+
+    let tickLabels = '';
+    labels.forEach((l, i) => {
+      if (labels.length > 10 && i % Math.ceil(labels.length / 8) !== 0) return;
+      tickLabels += `<text x="${points[i][0].toFixed(1)}" y="${h - 4}" text-anchor="middle" font-size="9" style="fill:var(--text-subtle);">${l}</text>`;
+    });
+
+    return `<svg viewBox="0 0 ${w} ${h}" style="width:100%; height:${h}px; display:block;">
+      ${area}
+      <polyline points="${polyline}" style="fill:none; stroke:${color}; stroke-width:2;"></polyline>
+      ${dots}
+      ${tickLabels}
+    </svg>`;
+  }
+
